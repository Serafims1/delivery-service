app:
  name: "International Delivery Service"
  debug: false
  secret_key: "change-me"

server:
  host: "0.0.0.0"
  port: 8000

database:
  host: "postgres"
  port: 5432
  name: "delivery"
  user: "postgres"
  password: "change-me"

redis:
  host: "redis"
  port: 6379
  db: 0
  exchange_rate_ttl_seconds: 300
  idempotency_ttl_seconds: 300

exchange_rate:
  url: "https://www.cbr-xml-daily.ru/daily_json.js"
  request_timeout_seconds: 5

rabbitmq:
  host: "rabbitmq"
  port: 5672
  user: "delivery_user"
  password: "change-me"